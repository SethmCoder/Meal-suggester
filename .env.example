# Copy to .env and fill in values. Restart the Vite dev server after changes.

# Supabase (optional — local storage works without these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI-compatible chat + vision (meal assistant ranking + photo inventory)
# Example OpenAI:
# VITE_AI_BASE_URL=https://api.openai.com/v1
# VITE_AI_API_KEY=sk-...
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini
VITE_AI_VISION_MODEL=gpt-4o-mini

# Spoonacular (optional — needed to find RecipeTin Eats, Just One Cookbook, etc.
# when those publishers are indexed; Planora only shows source links returned by the API)
VITE_SPOONACULAR_API_KEY=
