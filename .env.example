# Copy to .env and fill in values. Restart the Vite dev server after changes.

# Supabase (optional — local storage works without these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Groq (default in this project) ---
# https://console.groq.com/keys
VITE_AI_BASE_URL=https://api.groq.com/openai/v1
VITE_AI_API_KEY=
VITE_AI_MODEL=openai/gpt-oss-20b
VITE_AI_VISION_MODEL=qwen/qwen3.8-27b

# OpenAI alternative:
# VITE_AI_BASE_URL=https://api.openai.com/v1
# VITE_AI_API_KEY=sk-...
# VITE_AI_MODEL=gpt-4o-mini
# VITE_AI_VISION_MODEL=gpt-4o-mini

# Spoonacular (optional backup — preferred sites scrape via local Vite API)
VITE_SPOONACULAR_API_KEY=
